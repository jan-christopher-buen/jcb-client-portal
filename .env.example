# Copy to .env and supply local credentials; these are placeholders only.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/jcb_portal_dev
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/jcb_portal_test
SESSION_SECRET=replace-with-at-least-32-random-characters
# Loopback-only SMTP sink (npm run mail:dev). No external delivery.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Production defaults to disabled. Local remains restricted to loopback SMTP.
INVITATION_MAIL_MODE=local
# Resend mode requires all three values; use private service settings, never VITE_*.
# RESEND_API_KEY=<sending-only-key>
# INVITATION_FROM=invites@staging-mail.example.com
# STAGING_INVITATION_RECIPIENTS=controlled-one@example.com,controlled-two@example.com
