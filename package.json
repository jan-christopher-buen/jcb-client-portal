{
  "name": "jcb-client-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @jcb/api\" \"npm run dev -w @jcb/web\"",
    "build": "npm run db:generate && npm run build -w @jcb/contracts && npm run build -w @jcb/web && npm run build -w @jcb/api",
    "start": "node --env-file-if-exists=.env apps/api/dist/server.js",
    "lint": "eslint .",
    "typecheck": "npm run db:generate && npm run typecheck --workspaces && tsc --noEmit -p tsconfig.tools.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "tsx scripts/integration.ts",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:seed": "tsx scripts/database.ts seed",
    "predev": "npm run build -w @jcb/contracts",
    "owner:create": "npm run build -w @jcb/contracts && tsx scripts/owner.ts",
    "mail:dev": "tsx scripts/mail-sink.ts",
    "pretest": "npm run build -w @jcb/contracts",
    "pretest:integration": "npm run build -w @jcb/contracts",
    "demo:seed": "npm run db:generate && npm run build -w @jcb/contracts && tsx scripts/demo.ts seed",
    "demo:dev": "npm run build -w @jcb/contracts && tsx scripts/demo.ts dev",
    "test:ui": "node --test --test-concurrency=1 --test-timeout=60000 apps/web/tests/*.ui.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/mailparser": "3.9.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/passport": "1.0.17",
    "@types/passport-local": "1.0.38",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/smtp-server": "3.5.13",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "10.0.6",
    "dotenv": "18.0.9",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "mailparser": "3.14.1",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "smtp-server": "3.21.3",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  }
}
