generator client {
  provider = "prisma-client"
  output = "../apps/api/src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
model Session {
  sid String @id @db.VarChar
  sess Json @db.Json
  expire DateTime @db.Timestamp(6)
  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
enum Role {
  OWNER
  CLIENT
}
enum ActivityKind {
  INVITATION_CREATED
  INVITATION_REVOKED
  INVITATION_ACCEPTED
  INVITATION_DELIVERY_FAILED
  MEMBERSHIP_ACTIVATED
  MEMBERSHIP_REVOKED
  PROPOSAL_CREATED
  PROPOSAL_SENT
  PROPOSAL_SUPERSEDED
  PROPOSAL_DECIDED
  PROJECT_CREATED
  PROJECT_STATUS_CHANGED
  MILESTONE_CREATED
  MILESTONE_EDITED
  MILESTONE_STARTED
  MILESTONE_SUBMITTED
  MILESTONE_WITHDRAWN
  MILESTONE_REOPENED
  MILESTONE_DECIDED
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  name String
  passwordHash String @map("password_hash")
  role Role @default(CLIENT)
  disabledAt DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  memberships Membership[]
  invitations Invitation[]
  activities ActivityEvent[]
  workflowEvents WorkflowEvent[]
  submittedReviews MilestoneReview[] @relation("ReviewSubmitter")
  decidedReviews MilestoneReview[] @relation("ReviewDecider")
  withdrawnReviews MilestoneReview[] @relation("ReviewWithdrawer")
  proposalDecisions ProposalDecision[]
  @@map("users")
}
model Organization {
  id String @id @default(uuid()) @db.Uuid
  name String
  notes String @default("")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  proposals Proposal[]
  projects Project[]
  contacts Contact[]
  memberships Membership[]
  invitations Invitation[]
  activities ActivityEvent[]
  @@index([createdAt, id])
  @@map("organizations")
}
model Contact {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name String
  email String
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  @@unique([organizationId, email])
  @@map("contacts")
}
model Membership {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([organizationId, userId])
  @@index([userId, revokedAt])
  @@map("memberships")
}
model Invitation {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email String
  tokenHash String @unique @map("token_hash")
  invitedBy String @map("invited_by") @db.Uuid
  inviter User @relation(fields: [invitedBy], references: [id], onDelete: Restrict)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  deliveryFailed Boolean @default(false) @map("delivery_failed")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([organizationId, email])
  @@index([invitedBy])
  @@map("invitations")
}
model ActivityEvent {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorId String @map("actor_id") @db.Uuid
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  kind ActivityKind
  targetId String @map("target_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([organizationId, createdAt])
  @@index([actorId])
  @@map("activity_events")
}
model AuthThrottle {
  key String @id
  count Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(6)
  @@index([resetAt])
  @@map("auth_throttles")
}

enum ProposalState {
 DRAFT
 SENT
 SUPERSEDED
 APPROVED
 DECLINED
}
enum DecisionOutcome {
 APPROVED
 DECLINED
}
enum ProjectStatus {
 PLANNED
 ACTIVE
 IN_REVIEW
 ON_HOLD
 CANCELLED
}
enum MilestoneStatus {
 PLANNED
 IN_PROGRESS
 IN_REVIEW
 ACCEPTED
}
enum ReviewStatus {
 PENDING
 ACCEPTED
 CHANGES_REQUESTED
 WITHDRAWN
}
model Proposal {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
 publishedVersionId String? @map("published_version_id") @db.Uuid
 publishedVersion ProposalVersion? @relation("PublishedVersion", fields: [publishedVersionId, id, organizationId], references: [id, proposalId, organizationId], onDelete: Restrict, onUpdate: NoAction)
 lockRevision Int @default(0) @map("lock_revision")
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 versions ProposalVersion[] @relation("ProposalVersions")
 projects Project[]
 @@unique([id, organizationId])
 @@index([organizationId, createdAt, id])
 @@map("proposals")
}
model ProposalVersion {
 id String @id @default(uuid()) @db.Uuid
 proposalId String @map("proposal_id") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 proposal Proposal @relation("ProposalVersions", fields: [proposalId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: NoAction)
 publishedFor Proposal[] @relation("PublishedVersion")
 number Int
 state ProposalState @default(DRAFT)
 editRevision Int @default(0) @map("edit_revision")
 title String
 scope String
 exclusions String
 deliveryAssumptions String @map("delivery_assumptions")
 internalNotes String @default("") @map("internal_notes")
 currency String @default("PHP") @db.VarChar(3)
 items Json @db.JsonB
 totalMinor BigInt @map("total_minor")
 sentAt DateTime? @map("sent_at") @db.Timestamptz(6)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 decision ProposalDecision?
 projects Project[]
 @@unique([proposalId, number])
 @@unique([id, proposalId, organizationId])
 @@map("proposal_versions")
}
model ProposalDecision {
 id String @id @default(uuid()) @db.Uuid
 versionId String @unique @map("version_id") @db.Uuid
 version ProposalVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
 actorId String @map("actor_id") @db.Uuid
 actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
 outcome DecisionOutcome
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 projects Project[]
 @@index([actorId])
 @@map("proposal_decisions")
}
model Project {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
 proposalId String @unique @map("proposal_id") @db.Uuid
 proposal Proposal @relation(fields: [proposalId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: NoAction)
 approvedVersionId String @unique @map("approved_version_id") @db.Uuid
 approvedVersion ProposalVersion @relation(fields: [approvedVersionId, proposalId, organizationId], references: [id, proposalId, organizationId], onDelete: Restrict, onUpdate: NoAction)
 approval ProposalDecision @relation(fields: [approvedVersionId], references: [versionId], onDelete: Restrict, onUpdate: NoAction)
 status ProjectStatus @default(PLANNED)
 resumeStatus ProjectStatus? @map("resume_status")
 lockRevision Int @default(0) @map("lock_revision")
 milestones Milestone[]
 workflowEvents WorkflowEvent[]
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 @@index([organizationId, createdAt, id])
 @@unique([id, organizationId])
 @@map("projects")
}

model Milestone {
 id String @id @default(uuid()) @db.Uuid
 projectId String @map("project_id") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 project Project @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: NoAction)
 title String
 description String
 dueDate DateTime? @map("due_date") @db.Date
 required Boolean @default(true)
 position Int
 status MilestoneStatus @default(PLANNED)
 revision Int @default(0)
 currentReviewId String? @map("current_review_id") @db.Uuid
 currentReview MilestoneReview? @relation("CurrentReview", fields: [currentReviewId, id], references: [id, milestoneId], onDelete: Restrict, onUpdate: NoAction)
 reviews MilestoneReview[] @relation("ReviewRounds")
 workflowEvents WorkflowEvent[]
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 @@unique([id, projectId, organizationId])
 @@unique([projectId, position])
 @@map("milestones")
}
model MilestoneReview {
 id String @id @default(uuid()) @db.Uuid
 milestoneId String @map("milestone_id") @db.Uuid
 milestone Milestone @relation("ReviewRounds", fields: [milestoneId], references: [id], onDelete: Restrict)
 currentFor Milestone[] @relation("CurrentReview")
 number Int
 title String
 description String
 status ReviewStatus @default(PENDING)
 submittedBy String @map("submitted_by") @db.Uuid
 submitter User @relation("ReviewSubmitter", fields: [submittedBy], references: [id], onDelete: Restrict)
 submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
 decisionActorId String? @map("decision_actor_id") @db.Uuid
 decisionActor User? @relation("ReviewDecider", fields: [decisionActorId], references: [id], onDelete: Restrict)
 decidedAt DateTime? @map("decided_at") @db.Timestamptz(6)
 feedback String?
 withdrawnBy String? @map("withdrawn_by") @db.Uuid
 withdrawer User? @relation("ReviewWithdrawer", fields: [withdrawnBy], references: [id], onDelete: Restrict)
 withdrawnAt DateTime? @map("withdrawn_at") @db.Timestamptz(6)
 withdrawalReason String? @map("withdrawal_reason")
 @@unique([milestoneId, number])
 @@unique([id, milestoneId])
 @@index([submittedBy])
 @@index([decisionActorId])
 @@index([withdrawnBy])
 @@map("milestone_reviews")
}
model WorkflowEvent {
 id String @id @default(uuid()) @db.Uuid
 projectId String @map("project_id") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 project Project @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: NoAction)
 milestoneId String? @map("milestone_id") @db.Uuid
 milestone Milestone? @relation(fields: [milestoneId, projectId, organizationId], references: [id, projectId, organizationId], onDelete: Restrict, onUpdate: NoAction)
 actorId String @map("actor_id") @db.Uuid
 actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
 kind ActivityKind
 fromState String? @map("from_state")
 toState String @map("to_state")
 reason String @default("")
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 @@index([projectId, createdAt, id])
 @@index([milestoneId])
 @@index([actorId])
 @@map("workflow_events")
}
